include LICENSE
include README.md
include README.zh-CN.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include requirements.txt
include requirements-lock.txt
include Makefile
recursive-include schemas *.json *.yaml
recursive-include references *.md *.yaml
recursive-include skill/biomed-research-integrity-auditor *
recursive-include webapp/frontend/dist *
recursive-include docs *.md
recursive-include examples *
recursive-include benchmarks *.py *.md *.json *.csv *.txt *.jpg *.png *.pdf
recursive-include evals *.py *.json *.csv *.txt *.md *.pdf *.png *.yaml
prune audit_outputs
prune benchmarks/bria_bench/runs
recursive-exclude benchmarks/bria_bench/results *
include benchmarks/bria_bench/results/.gitkeep
include benchmarks/bria_bench/results/release_summary_*.json
include benchmarks/bria_bench/results/public_summary_*.json
prune benchmarks/bria_bench/reviewer_packets
prune benchmarks/bria_bench/reviewer-packets
prune benchmarks/bria_bench/reviewer_packet
prune benchmarks/bria_bench/reviewer-packet
prune benchmarks/bria_bench/mappings
prune benchmarks/bria_bench/reviewer_mappings
prune benchmarks/bria_bench/api_cache
prune benchmarks/bria_bench/.api_cache
prune benchmarks/bria_bench/cache
prune benchmarks/bria_bench/.cache
prune benchmarks/bria_bench/metrics
prune benchmarks/bria_bench/local_metrics
prune benchmarks/bria_bench/seeds
prune benchmarks/bria_bench/identity
prune benchmarks/bria_bench/identities
exclude benchmarks/bria_bench/run_summary.json
exclude benchmarks/bria_bench/metrics.json
exclude benchmarks/bria_bench/metrics-*.json
exclude benchmarks/bria_bench/local_metrics*.json
exclude benchmarks/bria_bench/reviewer_mapping*.json
exclude benchmarks/bria_bench/*_mapping.json
exclude benchmarks/bria_bench/reviewer_packet*.zip
exclude benchmarks/bria_bench/reviewer_packet*.json
exclude benchmarks/bria_bench/seed*.txt
exclude benchmarks/bria_bench/seed*.json
exclude benchmarks/bria_bench/*identity*.json
exclude benchmarks/bria_bench/*api_cache*.json
prune evals/outputs
prune evals/prompts
prune evals/scorecards
prune tmp
prune webapp/frontend/node_modules
global-exclude *.py[cod]

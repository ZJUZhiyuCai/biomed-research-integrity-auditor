include LICENSE
include README.md
include README.zh-CN.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include requirements.txt
include requirements-lock.txt
include Makefile
recursive-include schemas *.json *.yaml
recursive-include references *.md *.yaml
recursive-include skill/biomed-research-integrity-auditor *
recursive-include webapp/frontend/dist *
recursive-include docs *.md
recursive-include examples *
recursive-include benchmarks *.py *.md *.json *.csv *.txt *.jpg *.png *.pdf
recursive-include evals *.py *.json *.csv *.txt *.md *.pdf *.png *.yaml
prune audit_outputs
recursive-exclude benchmarks/bria_bench runs/**
recursive-exclude benchmarks/bria_bench reviewer_packets/**
recursive-exclude benchmarks/bria_bench reviewer-packets/**
recursive-exclude benchmarks/bria_bench reviewer_packet/**
recursive-exclude benchmarks/bria_bench reviewer-packet/**
recursive-exclude benchmarks/bria_bench locked_submissions/**
recursive-exclude benchmarks/bria_bench locked-submissions/**
recursive-exclude benchmarks/bria_bench comparisons/**
recursive-exclude benchmarks/bria_bench adjudications/**
recursive-exclude benchmarks/bria_bench finalizations/**
recursive-exclude benchmarks/bria_bench mappings/**
recursive-exclude benchmarks/bria_bench reviewer_mappings/**
recursive-exclude benchmarks/bria_bench reviewer-mappings/**
recursive-exclude benchmarks/bria_bench api_cache/**
recursive-exclude benchmarks/bria_bench api-cache/**
recursive-exclude benchmarks/bria_bench .api_cache/**
recursive-exclude benchmarks/bria_bench .api-cache/**
recursive-exclude benchmarks/bria_bench cache/**
recursive-exclude benchmarks/bria_bench .cache/**
recursive-exclude benchmarks/bria_bench metrics/**
recursive-exclude benchmarks/bria_bench local_metrics/**
recursive-exclude benchmarks/bria_bench local-metrics/**
recursive-exclude benchmarks/bria_bench seeds/**
recursive-exclude benchmarks/bria_bench identity/**
recursive-exclude benchmarks/bria_bench identities/**
recursive-exclude benchmarks/bria_bench results/**
include benchmarks/bria_bench/results/.gitkeep
include benchmarks/bria_bench/results/release_summary_*.json
include benchmarks/bria_bench/results/public_summary_*.json
recursive-exclude benchmarks/bria_bench run_summary.json
recursive-exclude benchmarks/bria_bench run-summary.json
recursive-exclude benchmarks/bria_bench metrics.json metrics-*.json metrics_*.json
recursive-exclude benchmarks/bria_bench local_metrics*.json local-metrics*.json
recursive-exclude benchmarks/bria_bench reviewer_mapping*.json reviewer-mapping*.json *_mapping.json *-mapping.json
recursive-exclude benchmarks/bria_bench reviewer_packet*.json reviewer_packet*.zip
recursive-exclude benchmarks/bria_bench reviewer-packet*.json reviewer-packet*.zip
recursive-exclude benchmarks/bria_bench comparison*.json adjudication*.json submission*.json finalization*.json
recursive-exclude benchmarks/bria_bench seed*.json seed*.txt
recursive-exclude benchmarks/bria_bench *identity*.json
recursive-exclude benchmarks/bria_bench *api_cache*.json *api-cache*.json
recursive-exclude benchmarks/bria_bench/schemas *.schema.json
include benchmarks/bria_bench/schemas/annotation.schema.json
include benchmarks/bria_bench/schemas/benchmark_manifest.schema.json
include benchmarks/bria_bench/schemas/metrics.schema.json
include benchmarks/bria_bench/schemas/observation.schema.json
include benchmarks/bria_bench/schemas/reviewer_form_completed.schema.json
include benchmarks/bria_bench/schemas/reviewer_form_independent_completed.schema.json
include benchmarks/bria_bench/schemas/reviewer_form_independent_template.schema.json
include benchmarks/bria_bench/schemas/reviewer_form_template.schema.json
include benchmarks/bria_bench/schemas/reviewer_adjudication.schema.json
include benchmarks/bria_bench/schemas/reviewer_comparison.schema.json
include benchmarks/bria_bench/schemas/reviewer_finalization.schema.json
include benchmarks/bria_bench/schemas/reviewer_mapping.schema.json
include benchmarks/bria_bench/schemas/reviewer_packet_manifest.schema.json
include benchmarks/bria_bench/schemas/reviewer_submission.schema.json
include benchmarks/bria_bench/schemas/run_result.schema.json
prune evals/outputs
prune evals/prompts
prune evals/scorecards
prune tmp
prune webapp/frontend/node_modules
global-exclude *.py[cod]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/reviewer_packet_manifest.schema.json",
  "title": "BRIA-Bench Reviewer Packet Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "packet_scope",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "packet_scope": {
      "const": "workflow_demo_only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewerCaseId": {
      "type": "string",
      "pattern": "^BRIA-R[0-9]{3,}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "case": {
      "type": "object",
      "required": [
        "reviewer_case_id",
        "source_package_sha256",
        "annotation_schema_version"
      ],
      "properties": {
        "reviewer_case_id": {
          "$ref": "#/$defs/reviewerCaseId"
        },
        "source_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "annotation_schema_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/reviewer_form_template.schema.json",
  "title": "BRIA-Bench Blank Reviewer Form Template",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "items": {
    "$ref": "#/$defs/blankRow"
  },
  "$defs": {
    "blankRow": {
      "type": "object",
      "required": [
        "reviewer_case_id",
        "presence",
        "comment_class",
        "locations",
        "observation",
        "scientific_relevance",
        "benign_explanations",
        "required_materials",
        "recommended_action"
      ],
      "properties": {
        "reviewer_case_id": {
          "type": "string",
          "pattern": "^BRIA-R[0-9]{3,}$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "presence": {
          "type": "null"
        },
        "comment_class": {
          "type": "null"
        },
        "locations": {
          "$ref": "#/$defs/emptyArray"
        },
        "observation": {
          "$ref": "#/$defs/emptyString"
        },
        "scientific_relevance": {
          "$ref": "#/$defs/emptyString"
        },
        "benign_explanations": {
          "$ref": "#/$defs/emptyArray"
        },
        "required_materials": {
          "$ref": "#/$defs/emptyArray"
        },
        "recommended_action": {
          "$ref": "#/$defs/emptyString"
        }
      },
      "additionalProperties": false
    },
    "emptyArray": {
      "type": "array",
      "maxItems": 0
    },
    "emptyString": {
      "type": "string",
      "maxLength": 0
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/reviewer_form_independent_completed.schema.json",
  "title": "BRIA-Bench Completed Independent Reviewer Form",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/completedRow"
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "riskLevel": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "riskRange": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/riskLevel"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "reviewerCaseId": {
      "type": "string",
      "pattern": "^BRIA-R[0-9]{3,}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "reviewerObservationId": {
      "type": "string",
      "pattern": "^BRIA-R[0-9]{3,}-O[0-9]{3,}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "completedRow": {
      "type": "object",
      "required": [
        "reviewer_case_id",
        "reviewer_observation_id",
        "presence",
        "issue_family",
        "comment_class",
        "risk_range",
        "locations",
        "observation",
        "minimum_review_comment",
        "scientific_relevance",
        "benign_explanations",
        "required_materials",
        "recommended_action"
      ],
      "properties": {
        "reviewer_case_id": {
          "$ref": "#/$defs/reviewerCaseId"
        },
        "reviewer_observation_id": {
          "$ref": "#/$defs/reviewerObservationId"
        },
        "presence": {
          "enum": [
            "present",
            "absent",
            "insufficient_materials"
          ]
        },
        "issue_family": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonemptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "comment_class": {
          "enum": [
            "major",
            "minor",
            "materials_request",
            null
          ]
        },
        "risk_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/riskRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "locations": {
          "$ref": "#/$defs/stringList"
        },
        "observation": {
          "type": "string"
        },
        "minimum_review_comment": {
          "type": "string"
        },
        "scientific_relevance": {
          "type": "string"
        },
        "benign_explanations": {
          "$ref": "#/$defs/stringList"
        },
        "required_materials": {
          "$ref": "#/$defs/stringList"
        },
        "recommended_action": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "presence": {
                "const": "present"
              }
            }
          },
          "then": {
            "properties": {
              "issue_family": {
                "$ref": "#/$defs/nonemptyString"
              },
              "comment_class": {
                "enum": [
                  "major",
                  "minor"
                ]
              },
              "risk_range": {
                "$ref": "#/$defs/riskRange"
              },
              "locations": {
                "minItems": 1
              },
              "observation": {
                "$ref": "#/$defs/nonemptyString"
              },
              "minimum_review_comment": {
                "$ref": "#/$defs/nonemptyString"
              },
              "scientific_relevance": {
                "$ref": "#/$defs/nonemptyString"
              },
              "benign_explanations": {
                "minItems": 1
              },
              "required_materials": {
                "minItems": 1
              },
              "recommended_action": {
                "$ref": "#/$defs/nonemptyString"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presence": {
                "const": "insufficient_materials"
              }
            }
          },
          "then": {
            "properties": {
              "issue_family": {
                "$ref": "#/$defs/nonemptyString"
              },
              "comment_class": {
                "const": "materials_request"
              },
              "risk_range": {
                "$ref": "#/$defs/riskRange"
              },
              "locations": {
                "minItems": 1
              },
              "observation": {
                "$ref": "#/$defs/nonemptyString"
              },
              "minimum_review_comment": {
                "$ref": "#/$defs/nonemptyString"
              },
              "scientific_relevance": {
                "$ref": "#/$defs/nonemptyString"
              },
              "benign_explanations": {
                "minItems": 1
              },
              "required_materials": {
                "minItems": 1
              },
              "recommended_action": {
                "$ref": "#/$defs/nonemptyString"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presence": {
                "const": "absent"
              }
            }
          },
          "then": {
            "properties": {
              "issue_family": {
                "type": "null"
              },
              "comment_class": {
                "type": "null"
              },
              "risk_range": {
                "type": "null"
              },
              "locations": {
                "maxItems": 0
              },
              "observation": {
                "maxLength": 0
              },
              "minimum_review_comment": {
                "maxLength": 0
              },
              "scientific_relevance": {
                "maxLength": 0
              },
              "benign_explanations": {
                "maxItems": 0
              },
              "required_materials": {
                "maxItems": 0
              },
              "recommended_action": {
                "maxLength": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}

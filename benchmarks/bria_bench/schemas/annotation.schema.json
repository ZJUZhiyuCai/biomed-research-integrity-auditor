{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/annotation.schema.json",
  "title": "BRIA-Bench Case Annotation",
  "type": "object",
  "required": [
    "case_id",
    "negative_control",
    "review_status",
    "expected_observations"
  ],
  "propertyNames": {
    "not": {
      "enum": [
        "misconduct",
        "fraud",
        "fake",
        "guilty"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "negative_control": {
      "type": "boolean"
    },
    "review_status": {
      "enum": [
        "controlled_ground_truth",
        "independent_pending",
        "independent_adjudicated",
        "ambiguous"
      ]
    },
    "expected_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expectedObservation"
      }
    },
    "reviewer_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "adjudicator_id": {
      "type": "string",
      "minLength": 1
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_annotation_path": {
      "type": "string",
      "minLength": 1
    },
    "legacy_regression_contract": {
      "$ref": "#/$defs/legacyRegressionContract"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "legacyRegressionContract": {
      "type": "object",
      "required": [
        "source_label_path",
        "source_label_sha256",
        "case_id",
        "case_type_hidden",
        "audit_mode",
        "expected_behavior",
        "required_findings",
        "forbidden_outputs",
        "risk_caps"
      ],
      "properties": {
        "source_label_path": {
          "type": "string",
          "pattern": "^evals/ground_truth/case_[0-9]{3}\\.expected\\.yaml$"
        },
        "source_label_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^case_[0-9]{3}$"
        },
        "case_type_hidden": {
          "type": "string",
          "minLength": 1
        },
        "audit_mode": {
          "enum": [
            "internal_presubmission",
            "external_literature_triage"
          ]
        },
        "expected_behavior": {
          "$ref": "#/$defs/legacyExpectedBehavior"
        },
        "required_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacyRequiredFinding"
          }
        },
        "required_report_terms": {
          "$ref": "#/$defs/stringList"
        },
        "forbidden_outputs": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "risk_caps": {
          "$ref": "#/$defs/legacyRiskCaps"
        }
      },
      "additionalProperties": false
    },
    "legacyExpectedBehavior": {
      "type": "object",
      "required": [
        "misconduct_verdict_allowed",
        "min_overall_risk",
        "max_overall_risk"
      ],
      "properties": {
        "misconduct_verdict_allowed": {
          "type": "boolean"
        },
        "min_overall_risk": {
          "$ref": "#/$defs/riskLevel"
        },
        "max_overall_risk": {
          "$ref": "#/$defs/riskLevel"
        }
      },
      "additionalProperties": false
    },
    "legacyRequiredFinding": {
      "type": "object",
      "required": [
        "finding_type",
        "expected_risk_range",
        "locations_should_include",
        "evidence_should_include",
        "required_materials_should_include",
        "benign_explanations_should_include_any"
      ],
      "properties": {
        "finding_type": {
          "enum": [
            "image_reuse_cluster",
            "local_patch_reuse",
            "terminal_digit_anomaly",
            "precision_mixing",
            "cross_file_sequence_reuse",
            "sd_sem_inconsistency",
            "integer_count_inconsistency",
            "linear_shift_pattern",
            "affine_transform_pattern",
            "rank_pattern_reuse",
            "residual_pattern_reuse",
            "methods_boilerplate_overlap",
            "text_overlap_candidate",
            "self_overlap_candidate",
            "SD is not consistent",
            "weak triage signal",
            "pseudoreplication_candidate",
            "whole-column",
            "longitudinal",
            "Time-stratified",
            "precision",
            "Identical numeric sequence",
            "Integer-count"
          ]
        },
        "expected_risk_range": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/riskLevel"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "locations_should_include": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "evidence_should_include": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "required_materials_should_include": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "benign_explanations_should_include_any": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "legacyRiskCaps": {
      "type": "object",
      "required": [
        "weak_statistics_only_max",
        "public_pdf_only_max"
      ],
      "properties": {
        "weak_statistics_only_max": {
          "$ref": "#/$defs/riskLevel"
        },
        "public_pdf_only_max": {
          "$ref": "#/$defs/riskLevel"
        }
      },
      "additionalProperties": false
    },
    "expectedObservation": {
      "type": "object",
      "required": [
        "observation_id",
        "role",
        "issue_family",
        "location",
        "risk_range",
        "benign_explanations",
        "required_materials"
      ],
      "propertyNames": {
        "not": {
          "enum": [
            "misconduct",
            "fraud",
            "fake",
            "guilty"
          ]
        }
      },
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "recall_label",
            "coverage_gap",
            "negative_guardrail",
            "reference_only"
          ]
        },
        "issue_family": {
          "$ref": "#/$defs/issueFamily"
        },
        "compatible_issue_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issueFamily"
          },
          "uniqueItems": true
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "risk_range": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/riskLevel"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "benign_explanations": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "required_materials": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "presence": {
          "enum": [
            "present",
            "absent",
            "insufficient_materials"
          ]
        },
        "expected_fact": {
          "type": "string"
        },
        "minimum_review_comment": {
          "type": "string"
        },
        "comment_priority": {
          "enum": [
            "major",
            "minor",
            "materials_request"
          ]
        },
        "evaluation_scope": {
          "enum": [
            "regression_only",
            "headline_detection",
            "localization_only",
            "reliability_only",
            "reference_only"
          ]
        },
        "source_label_path": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "location": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "not": {
              "enum": [
                "misconduct",
                "fraud",
                "fake",
                "guilty"
              ]
            }
          },
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "terms": {
              "$ref": "#/$defs/stringList",
              "minItems": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "figure": {
              "type": "string",
              "minLength": 1
            },
            "panel": {
              "type": "string",
              "minLength": 1
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "sheet": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "$ref": "#/$defs/stringList",
              "minItems": 1
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            },
            "cell_range": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "minLength": 1
            },
            "paragraph": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "$ref": "#/$defs/region"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "region": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height",
        "coordinate_space"
      ],
      "propertyNames": {
        "not": {
          "enum": [
            "misconduct",
            "fraud",
            "fake",
            "guilty"
          ]
        }
      },
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coordinate_space": {
          "enum": [
            "normalized_0_1",
            "pixels"
          ]
        }
      },
      "additionalProperties": false
    },
    "issueFamily": {
      "type": "string",
      "minLength": 1
    },
    "riskLevel": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

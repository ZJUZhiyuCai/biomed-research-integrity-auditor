{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/reviewer_submission.schema.json",
  "title": "BRIA-Bench Locked Independent Reviewer Submission",
  "type": "object",
  "required": [
    "schema_version",
    "packet_scope",
    "review_round_id",
    "reviewer_id",
    "locked_at",
    "packet_manifest_sha256",
    "packet_tree_sha256",
    "form_schema",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "packet_scope": {
      "const": "independent_blinded"
    },
    "review_round_id": {
      "$ref": "#/$defs/reviewRoundId"
    },
    "reviewer_id": {
      "$ref": "#/$defs/reviewerId"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "packet_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "packet_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "form_schema": {
      "const": "reviewer_form_independent_completed.schema.json"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewRoundId": {
      "type": "string",
      "pattern": "^BRIA-BLIND-[A-F0-9]{32}$"
    },
    "reviewerId": {
      "type": "string",
      "pattern": "^BRIA-REV-[A-Z0-9]{8,32}$"
    },
    "reviewerCaseId": {
      "type": "string",
      "pattern": "^BRIA-R[0-9]{3,}$"
    },
    "case": {
      "type": "object",
      "required": [
        "reviewer_case_id",
        "source_package_sha256",
        "form_path",
        "form_sha256",
        "row_count"
      ],
      "properties": {
        "reviewer_case_id": {
          "$ref": "#/$defs/reviewerCaseId"
        },
        "source_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "form_path": {
          "type": "string",
          "pattern": "^forms/BRIA-R[0-9]{3,}\\.json$"
        },
        "form_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

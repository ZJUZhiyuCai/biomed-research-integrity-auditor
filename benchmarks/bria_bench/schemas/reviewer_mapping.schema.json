{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/reviewer_mapping.schema.json",
  "title": "BRIA-Bench External Reviewer Mapping",
  "type": "object",
  "required": [
    "schema_version",
    "packet_manifest_sha256",
    "source_manifest_sha256",
    "selection_sha256",
    "anonymization",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "packet_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "anonymization": {
      "type": "object",
      "required": [
        "algorithm",
        "seed_commitment_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "hmac-sha256-ranked-permutation-v1"
        },
        "seed_commitment_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewerCaseId": {
      "type": "string",
      "pattern": "^BRIA-R[0-9]{3,}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "case": {
      "type": "object",
      "required": [
        "reviewer_case_id",
        "source_case_id",
        "source_package_sha256",
        "source_annotation_sha256"
      ],
      "properties": {
        "reviewer_case_id": {
          "$ref": "#/$defs/reviewerCaseId"
        },
        "source_case_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "source_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_annotation_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

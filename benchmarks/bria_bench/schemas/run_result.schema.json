{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/run_result.schema.json",
  "title": "BRIA-Bench Case Run Result",
  "type": "object",
  "required": [
    "case_id",
    "adapter",
    "status",
    "hashes",
    "cache_key",
    "telemetry",
    "output_paths",
    "normalized_observation",
    "failure"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "process_error",
        "timeout",
        "environment_failure",
        "contract_error",
        "normalization_error",
        "missing_output",
        "invalid_output",
        "skipped"
      ]
    },
    "hashes": {
      "$ref": "#/$defs/hashes"
    },
    "cache_key": {
      "$ref": "#/$defs/sha256"
    },
    "cache_status": {
      "enum": [
        "fresh",
        "reused",
        "invalidated"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "telemetry": {
      "$ref": "#/$defs/telemetry"
    },
    "output_paths": {
      "$ref": "#/$defs/outputPaths"
    },
    "normalized_observation": {
      "$ref": "#/$defs/normalizedObservation"
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/failureDetails"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hashes": {
      "type": "object",
      "required": [
        "package_sha256",
        "runner_sha256"
      ],
      "properties": {
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "annotation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": [
        "elapsed_seconds",
        "cpu_seconds",
        "peak_rss_bytes"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "output_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "module_seconds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "llm": {
          "$ref": "#/$defs/llmTelemetry"
        }
      },
      "additionalProperties": false
    },
    "llmTelemetry": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "latency_seconds": {
          "type": "number",
          "minimum": 0
        },
        "estimated_cost_cny": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "outputPaths": {
      "type": "object",
      "properties": {
        "case_output": {
          "type": "string",
          "minLength": 1
        },
        "run_result": {
          "type": "string",
          "minLength": 1
        },
        "audit_summary": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_summary": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "normalized_observation": {
          "type": "string",
          "minLength": 1
        },
        "stdout_log": {
          "type": "string",
          "minLength": 1
        },
        "stderr_log": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "normalizedObservation": {
      "type": "object",
      "required": [
        "case_id",
        "observations",
        "technical_failures",
        "reported_technical_failures",
        "boundary_violations",
        "contract_errors"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "technical_failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/technicalFailure"
          }
        },
        "reported_technical_failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/technicalFailure"
          }
        },
        "boundary_violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundaryViolation"
          }
        },
        "contract_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractError"
          }
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_id",
        "issue_family",
        "location",
        "risk_level"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_finding_id": {
          "type": "string",
          "minLength": 1
        },
        "source_detector": {
          "type": "string",
          "minLength": 1
        },
        "issue_family": {
          "type": "string",
          "minLength": 1
        },
        "finding_type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "risk_level": {
          "$ref": "#/$defs/riskLevel"
        },
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        },
        "benign_explanations": {
          "$ref": "#/$defs/stringList"
        },
        "benign_explanations_considered": {
          "$ref": "#/$defs/stringList"
        },
        "required_materials": {
          "$ref": "#/$defs/stringList"
        },
        "required_materials_to_resolve": {
          "$ref": "#/$defs/stringList"
        },
        "source_artifact": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "technicalFailure": {
      "type": "object",
      "required": [
        "module"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "failure_type": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reported": {
          "type": "boolean"
        },
        "returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "boundaryViolation": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "term": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "contractError": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "location": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "terms": {
              "$ref": "#/$defs/stringList"
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "figure": {
              "type": "string",
              "minLength": 1
            },
            "panel": {
              "type": "string",
              "minLength": 1
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "sheet": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "$ref": "#/$defs/stringList"
            },
            "rows": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            },
            "region": {
              "$ref": "#/$defs/region"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "region": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coordinate_space": {
          "enum": [
            "normalized",
            "pixels"
          ]
        }
      },
      "additionalProperties": false
    },
    "failureDetails": {
      "type": "object",
      "required": [
        "category",
        "message"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "stdout_tail": {
          "type": "string"
        },
        "stderr_tail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "riskLevel": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

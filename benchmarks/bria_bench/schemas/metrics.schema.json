{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bria-bench/schemas/metrics.schema.json",
  "title": "BRIA-Bench Metrics",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "detection",
    "reliability",
    "performance"
  ],
  "propertyNames": {
    "not": {
      "enum": [
        "score",
        "overall_score"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_count": {
      "type": "integer",
      "minimum": 0
    },
    "detection": {
      "$ref": "#/$defs/detection"
    },
    "reliability": {
      "$ref": "#/$defs/reliability"
    },
    "performance": {
      "$ref": "#/$defs/performance"
    },
    "tracks": {
      "$ref": "#/$defs/tracks"
    },
    "case_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fraction": {
      "type": "object",
      "required": [
        "numerator",
        "denominator",
        "value"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "countSummary": {
      "type": "object",
      "required": [
        "met",
        "not_met",
        "total"
      ],
      "properties": {
        "met": {
          "type": "integer",
          "minimum": 0
        },
        "not_met": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": [
        "count",
        "p50",
        "p95",
        "values"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "case_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseValue"
          }
        }
      },
      "additionalProperties": false
    },
    "caseValue": {
      "type": "object",
      "required": [
        "case_id",
        "value"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "score",
            "overall_score"
          ]
        }
      },
      "properties": {
        "expected_finding_recall": {
          "$ref": "#/$defs/fraction"
        },
        "negative_package_false_alert_rate": {
          "$ref": "#/$defs/fraction"
        },
        "location_match_rate": {
          "$ref": "#/$defs/fraction"
        },
        "risk_band_agreement": {
          "$ref": "#/$defs/fraction"
        },
        "coverage_gap_recall": {
          "$ref": "#/$defs/fraction"
        },
        "public_concern_location_coverage": {
          "$ref": "#/$defs/fraction"
        },
        "regression_assertions": {
          "$ref": "#/$defs/countSummary"
        }
      },
      "additionalProperties": false
    },
    "reliability": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "score",
            "overall_score"
          ]
        }
      },
      "properties": {
        "silent_failure_rate": {
          "$ref": "#/$defs/fraction"
        },
        "boundary_violation_rate": {
          "$ref": "#/$defs/fraction"
        },
        "manifest_attack_resistance": {
          "$ref": "#/$defs/fraction"
        },
        "report_contract_validity": {
          "$ref": "#/$defs/fraction"
        },
        "technical_failure_disclosure_rate": {
          "$ref": "#/$defs/fraction"
        },
        "run_completion_rate": {
          "$ref": "#/$defs/fraction"
        },
        "atomic_output_preservation": {
          "$ref": "#/$defs/fraction"
        },
        "previous_result_preservation": {
          "$ref": "#/$defs/fraction"
        }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "score",
            "overall_score"
          ]
        }
      },
      "properties": {
        "wall_time_seconds": {
          "$ref": "#/$defs/distribution"
        },
        "cpu_time_seconds": {
          "$ref": "#/$defs/distribution"
        },
        "peak_rss_bytes": {
          "$ref": "#/$defs/distribution"
        },
        "output_size_bytes": {
          "$ref": "#/$defs/distribution"
        },
        "over_budget_rate": {
          "$ref": "#/$defs/fraction"
        },
        "profiles": {
          "$ref": "#/$defs/profiles"
        },
        "module_seconds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/distribution"
          }
        },
        "llm_input_tokens": {
          "$ref": "#/$defs/distribution"
        },
        "llm_output_tokens": {
          "$ref": "#/$defs/distribution"
        },
        "llm_latency_seconds": {
          "$ref": "#/$defs/distribution"
        },
        "llm_estimated_cost_cny": {
          "$ref": "#/$defs/distribution"
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "properties": {
        "quick": {
          "$ref": "#/$defs/profilePerformance"
        },
        "standard": {
          "$ref": "#/$defs/profilePerformance"
        },
        "deep": {
          "$ref": "#/$defs/profilePerformance"
        }
      },
      "additionalProperties": false
    },
    "profilePerformance": {
      "type": "object",
      "properties": {
        "wall_time_seconds": {
          "$ref": "#/$defs/distribution"
        },
        "cpu_time_seconds": {
          "$ref": "#/$defs/distribution"
        },
        "peak_rss_bytes": {
          "$ref": "#/$defs/distribution"
        },
        "output_size_bytes": {
          "$ref": "#/$defs/distribution"
        },
        "over_budget_rate": {
          "$ref": "#/$defs/fraction"
        }
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "object",
      "properties": {
        "regression": {
          "$ref": "#/$defs/trackSummary"
        },
        "blinded_challenge": {
          "$ref": "#/$defs/trackSummary"
        },
        "public_realism": {
          "$ref": "#/$defs/trackSummary"
        },
        "public_concern": {
          "$ref": "#/$defs/trackSummary"
        },
        "robustness_scale": {
          "$ref": "#/$defs/trackSummary"
        }
      },
      "additionalProperties": false
    },
    "trackSummary": {
      "type": "object",
      "required": [
        "case_count",
        "headline_detection_eligible"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "headline_detection_eligible": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "caseResult": {
      "type": "object",
      "required": [
        "case_id",
        "track",
        "split",
        "status"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "enum": [
            "regression",
            "blinded_challenge",
            "public_realism",
            "public_concern",
            "robustness_scale"
          ]
        },
        "split": {
          "enum": [
            "dev",
            "test",
            "reference"
          ]
        },
        "status": {
          "enum": [
            "success",
            "process_error",
            "timeout",
            "environment_failure",
            "contract_error",
            "normalization_error",
            "missing_output",
            "invalid_output",
            "skipped"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "headline_detection_eligible": {
          "type": "boolean"
        },
        "matched_label_count": {
          "type": "integer",
          "minimum": 0
        },
        "expected_label_count": {
          "type": "integer",
          "minimum": 0
        },
        "false_alert_count": {
          "type": "integer",
          "minimum": 0
        },
        "technical_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "reported_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "output_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
